<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="AI Auto Agent V4.2" android:textSize="26sp" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Hybrid Accessibility + Pure Vision Game Mode" android:layout_marginBottom="12dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:id="@+id/preflightTitle" android:text="Preflight" android:textStyle="bold"
            android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/overlayCheck" android:text="○ Overlay permission"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/accessibilityCheck" android:text="○ Accessibility service"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/captureCheck" android:text="○ Screen capture permission"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <EditText android:id="@+id/gamePackage" android:hint="Game package (optional, e.g. com.example.game)" android:inputType="text"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/goal" android:hint="Goal (e.g. Search Weather on YouTube)" android:minLines="2"
            android:gravity="top" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/endpoint" android:hint="Endpoint (OpenAI-compatible or Gemini native)"
            android:inputType="textUri" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/model" android:hint="Model" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/apiKey" android:hint="API Key" android:inputType="textPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/provider" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <Button android:id="@+id/accessibility" android:text="Open Accessibility Settings"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/capture" android:text="Enable Screen Capture"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/overlay" android:text="Allow Floating STOP Overlay"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/start" android:text="START AGENT" android:enabled="false"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/stop" android:text="STOP AGENT"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/status" android:text="Status: preflight required" android:paddingTop="16dp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
